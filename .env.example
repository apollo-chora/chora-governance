# Local configuration for chora-governance.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_GRPC_PORT=9090

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
# CHORA_OUTBOX_DSN defaults to the same database when omitted.
POSTGRES_DB=chora_governance
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@postgres:5432/chora_governance?sslmode=disable
CHORA_OUTBOX_DSN=postgres://chora:chora@postgres:5432/chora_governance?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-governance-local

# Event bus — NATS JetStream. Unset disables the bus (in-memory fallback).
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CHORA_SOURCE_PROJECT=chora-local
CHORA_SOURCE_SERVICE=chora-governance

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
